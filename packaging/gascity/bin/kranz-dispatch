#!/bin/sh
# kranz-dispatch v2 — Gas City → kranz bridge, dispatch side.
#
# FAST PATH ONLY (gc order exec enforces a context deadline): drains READY
# beads carrying the kranz label by claiming each and SPOOLING a
# ticket-shaped mission brief for the long-lived kranz-city-worker to run.
# No mission executes here — dispatch and get out of the way.
#
# Scrutiny floor (docs/gascity.md lesson 3): a rig whose .kranz/config.json
# disables the scrutiny validator is REFUSED for autonomous dispatch — the
# bead stays open with an explanatory comment — unless
# KRANZ_ALLOW_UNVALIDATED=1 explicitly accepts letter-over-spirit risk.
#
# Rig routing: KRANZ_RIG_DIR wins when set (single-rig city); otherwise the
# bead id's prefix is resolved via `gc rig list --json`. A resolved rig must
# be a git checkout.
#
# Env:
#   KRANZ_RIG_DIR            explicit rig checkout (optional)
#   KRANZ_LABEL              bead label to drain (default "kranz")
#   KRANZ_MAX_CYCLES         fix-cycle bound per mission (default 1)
#   KRANZ_SPOOL              spool dir (default $GC_CITY/.gc/kranz-spool)
#   KRANZ_ALLOW_UNVALIDATED  =1 permits validators-off rigs (NOT recommended)
set -u

LABEL=${KRANZ_LABEL:-kranz}
MAX_CYCLES=${KRANZ_MAX_CYCLES:-1}
CITY=${GC_CITY:?GC_CITY is required (run via a gc order)}
SPOOL=${KRANZ_SPOOL:-$CITY/.gc/kranz-spool}
mkdir -p "$SPOOL"

resolve_rig() {
    # $1 = bead id. Echoes the rig checkout path, or nothing when unroutable.
    if [ -n "${KRANZ_RIG_DIR:-}" ]; then
        echo "$KRANZ_RIG_DIR"
        return
    fi
    PREFIX=${1%%-*}
    gc rig list --json 2>/dev/null |
        jq -r --arg p "$PREFIX" '.rigs[] | select(.prefix == $p) | .path' | head -1
}

READY=$(gc bd ready --label "$LABEL" --json 2>/dev/null | jq -r '.[].id') || READY=""
[ -n "$READY" ] || { echo "kranz-dispatch: no ready beads labeled '$LABEL'"; exit 0; }

for ID in $READY; do
    RIG_DIR=$(resolve_rig "$ID")
    if [ -z "$RIG_DIR" ] || [ ! -d "$RIG_DIR/.git" ]; then
        gc bd comment "$ID" "kranz-dispatch: no routable rig for prefix '${ID%%-*}' (set KRANZ_RIG_DIR or register the rig); bead left open" >/dev/null 2>&1
        continue
    fi
    if [ "${KRANZ_ALLOW_UNVALIDATED:-0}" != "1" ] &&
        jq -e '.skipScrutiny == true' "$RIG_DIR/.kranz/config.json" >/dev/null 2>&1; then
        gc bd comment "$ID" "kranz-dispatch: REFUSED — rig disables the scrutiny validator and autonomous missions with no adversarial reader satisfy the letter over the spirit (docs/gascity.md lesson 3). Re-enable scrutiny or set KRANZ_ALLOW_UNVALIDATED=1 deliberately." >/dev/null 2>&1
        continue
    fi

    BEAD=$(gc bd show "$ID" --json) || continue
    TITLE=$(printf '%s' "$BEAD" | jq -r '(if type == "array" then .[0] else . end) | .title // empty')
    DESC=$(printf '%s' "$BEAD" | jq -r '(if type == "array" then .[0] else . end) | .description // ""')
    ACCEPT=$(printf '%s' "$BEAD" | jq -r '(if type == "array" then .[0] else . end) | .acceptance_criteria // ""')

    STAMP=$(date +%s)
    MFILE="$SPOOL/$STAMP-$ID.md"
    {
        printf '## Goal\n%s\n\n' "$TITLE"
        printf '## Context\nDispatched from Gas City bead %s (label %s). Work fully autonomously.\n\n%s\n\n' "$ID" "$LABEL" "$DESC"
        printf '## Scoping answers\nNo human is available during this run. Prefer the smallest faithful interpretation; if materially ambiguous, block rather than guess. Validators stay enabled.\n\n'
        printf '## Acceptance hints\n%s\n' "${ACCEPT:-The goal above is demonstrably met.}"
    } > "$MFILE"
    {
        printf 'ID=%s\nCITY=%s\nRIG_DIR=%s\nMAX_CYCLES=%s\n' "$ID" "$CITY" "$RIG_DIR" "$MAX_CYCLES"
    } > "$SPOOL/$STAMP-$ID.env"

    gc bd update "$ID" --status in_progress >/dev/null 2>&1
    echo "kranz-dispatch: bead $ID spooled for $RIG_DIR"
done
