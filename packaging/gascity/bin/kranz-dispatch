#!/bin/sh
# kranz-dispatch v2 — Gas City → kranz bridge, dispatch side.
#
# FAST PATH ONLY (gc order exec enforces a context deadline): drains READY
# beads carrying the kranz label by atomically CLAIMING each (first-wins)
# and SPOOLING a ticket-shaped mission brief for the long-lived
# kranz-city-worker to run. No mission executes here — dispatch and get out
# of the way.
#
# Scrutiny floor (docs/gascity.md lesson 3): a rig whose .kranz/config.json
# disables the scrutiny validator is REFUSED for autonomous dispatch — the
# bead stays open with an explanatory comment — unless
# KRANZ_ALLOW_UNVALIDATED=1 explicitly accepts letter-over-spirit risk.
#
# Rig routing: KRANZ_RIG_DIR wins when set (single-rig city); otherwise the
# bead id's prefix is resolved via `gc rig list --json`. A resolved rig must
# be a git checkout.
#
# Atomic claim (shipped): after the rig-routing and scrutiny-floor refusals
# below — so a refused bead is never claimed — dispatch issues
# `gc bd update "$ID" --claim` BEFORE either spool file is written. Per
# docs/scoping/beads-bridge-dialect.md §3 (verified against installed bd
# 1.0.5), `--claim` atomically sets assignee and status to in_progress in
# one call, first-wins, and is idempotent if this dispatcher already holds
# the claim. If the claim fails — lost the race to another dispatcher, or
# any other bd error — the bead is skipped SILENTLY: no comment, no spool
# files, no orphan .md/.env pair.
#
# Lease-aware claim / liveness-first dead-claim recovery (ms-3-fix-1-6): bd
# 1.0.5 exposes no --lease/--lease-ttl/--heartbeat flag and no
# lease_expires_at/heartbeat_at field (docs/scoping/beads-bridge-dialect.md
# §3), so this bridge builds liveness on the one timestamp bd *does* expose
# on every issue: `updated_at` (`bd show --json`). Before computing the READY
# set, dispatch lists every in_progress bead carrying $LABEL (`gc bd list
# --label "$LABEL" --status in_progress --json`) and reaps any whose
# `updated_at` is at least $KRANZ_CLAIM_STALE_SECONDS old: `bd update <id>
# --status open --assignee ""` reopens it (assignee must be cleared too —
# `--claim` refuses a bead with any assignee set, live-probed 2026-07-31,
# regardless of status) so the normal READY/claim path below can re-drain it
# this same cycle. A holder that is still alive keeps its claim's
# `updated_at` fresh — see kranz-run-bead's heartbeat loop — so a live claim
# is never reaped; only a claim that has gone silent past the threshold is.
# KRANZ_CLAIM_STALE_SECONDS defaults to 1800s (30m).
#
# Residual exposure: a bead that is claimed and spooled but not yet picked up
# by kranz-city-worker (i.e. before kranz-run-bead's heartbeat loop starts)
# is covered only by the same staleness backstop above, not a live heartbeat
# — if kranz-city-worker never starts it, recovery still reaps it once
# KRANZ_CLAIM_STALE_SECONDS elapses.
#
# Env:
#   KRANZ_RIG_DIR            explicit rig checkout (optional)
#   KRANZ_LABEL              bead label to drain (default "kranz")
#   KRANZ_MAX_CYCLES         fix-cycle bound per mission (default 1)
#   KRANZ_SPOOL              spool dir (default $GC_CITY/.gc/kranz-spool)
#   KRANZ_ALLOW_UNVALIDATED  =1 permits validators-off rigs (NOT recommended)
#   KRANZ_CLAIM_STALE_SECONDS  dead-claim recovery threshold (default 1800)
#
# Bidirectional bead status <-> kranz-side state map (all four bead
# statuses, both directions):
#   open         <-> Queued           (ready for dispatch / re-readied)
#   in_progress  <-> Running          (set below by the atomic claim, before spooling)
#   blocked      <-> Blocked-report   (set by kranz-run-bead, exit 2)
#   closed       <-> Done             (set by kranz-run-bead, exit 0)
#
# Exit-code contract (kranz-run-bead owns the exit-code translation; this
# script only ever moves a bead from open to in_progress, via the atomic
# claim, before spooling):
#   0            -> closed  (mission COMPLETE)
#   2            -> blocked (mission BLOCKED, escalate to a human)
#   exit 3       -> open    (refused as UNDERSPECIFIED; refine and re-ready)
#   exit 1/other -> open    (mission FAILED; reopen for re-readying)
#
# open is many-to-one on the kranz side: both exit 3 (refused,
# underspecified brief) and exit 1/other (mission failed outright) return
# the bead to open, because neither outcome leaves partial progress worth
# preserving as "blocked" — the bead just needs to be re-readied, either
# after a human refines it (exit 3) or as-is for a retry (exit 1/other).
# Only exit 2 (blocked) preserves an in-flight state for escalation.
set -u

LABEL=${KRANZ_LABEL:-kranz}
MAX_CYCLES=${KRANZ_MAX_CYCLES:-1}
CITY=${GC_CITY:?GC_CITY is required (run via a gc order)}
SPOOL=${KRANZ_SPOOL:-$CITY/.gc/kranz-spool}
mkdir -p "$SPOOL"

resolve_rig() {
    # $1 = bead id. Echoes the rig checkout path, or nothing when unroutable.
    if [ -n "${KRANZ_RIG_DIR:-}" ]; then
        echo "$KRANZ_RIG_DIR"
        return
    fi
    PREFIX=${1%%-*}
    gc rig list --json 2>/dev/null |
        jq -r --arg p "$PREFIX" '.rigs[] | select(.prefix == $p) | .path' | head -1
}

STALE_SECONDS=${KRANZ_CLAIM_STALE_SECONDS:-1800}

to_epoch() {
    # $1 = bd's UTC timestamp (RFC3339, optionally with fractional seconds).
    # Echoes the epoch seconds, or nothing if it cannot be parsed.
    TS=$(printf '%s' "$1" | sed 's/\.[0-9]*Z$/Z/')
    date -u -j -f "%Y-%m-%dT%H:%M:%SZ" "$TS" +%s 2>/dev/null ||
        date -u -d "$TS" +%s 2>/dev/null
}

# Dead-claim recovery: reap any in_progress, $LABEL-carrying bead whose
# updated_at is stale, BEFORE computing this cycle's READY set, so a
# recovered bead is eligible for re-claim below in the same pass. A claim
# still being heartbeated (kranz-run-bead) has a fresh updated_at and is
# left alone.
NOW_EPOCH=$(date -u +%s)
STUCK=$(gc bd list --label "$LABEL" --status in_progress --json 2>/dev/null) || STUCK="[]"
printf '%s' "$STUCK" | jq -r '(if type == "array" then . else [] end)[] | [.id, .updated_at] | @tsv' 2>/dev/null |
    while IFS="$(printf '\t')" read -r SID SUPDATED; do
        [ -n "$SID" ] || continue
        SEPOCH=$(to_epoch "$SUPDATED")
        [ -n "$SEPOCH" ] || continue
        AGE=$((NOW_EPOCH - SEPOCH))
        if [ "$AGE" -ge "$STALE_SECONDS" ]; then
            if gc bd update "$SID" --status open --assignee "" >/dev/null 2>&1; then
                gc bd comment "$SID" "kranz-dispatch: dead-claim recovery — claim stale for ${AGE}s (>= ${STALE_SECONDS}s threshold), reopened for re-claim" >/dev/null 2>&1
            fi
        fi
    done

READY=$(gc bd ready --label "$LABEL" --json 2>/dev/null | jq -r '.[].id') || READY=""
[ -n "$READY" ] || { echo "kranz-dispatch: no ready beads labeled '$LABEL'"; exit 0; }

for ID in $READY; do
    RIG_DIR=$(resolve_rig "$ID")
    if [ -z "$RIG_DIR" ] || [ ! -d "$RIG_DIR/.git" ]; then
        gc bd comment "$ID" "kranz-dispatch: no routable rig for prefix '${ID%%-*}' (set KRANZ_RIG_DIR or register the rig); bead left open" >/dev/null 2>&1
        continue
    fi
    if [ "${KRANZ_ALLOW_UNVALIDATED:-0}" != "1" ] &&
        jq -e '.skipScrutiny == true' "$RIG_DIR/.kranz/config.json" >/dev/null 2>&1; then
        gc bd comment "$ID" "kranz-dispatch: REFUSED — rig disables the scrutiny validator and autonomous missions with no adversarial reader satisfy the letter over the spirit (docs/gascity.md lesson 3). Re-enable scrutiny or set KRANZ_ALLOW_UNVALIDATED=1 deliberately." >/dev/null 2>&1
        continue
    fi

    # Atomic, first-wins claim BEFORE any spool write. A failed claim means
    # another dispatcher won the race (or some other bd error): skip
    # silently, no comment, no spool files.
    gc bd update "$ID" --claim >/dev/null 2>&1 || continue

    BEAD=$(gc bd show "$ID" --json) || continue
    TITLE=$(printf '%s' "$BEAD" | jq -r '(if type == "array" then .[0] else . end) | .title // empty')
    DESC=$(printf '%s' "$BEAD" | jq -r '(if type == "array" then .[0] else . end) | .description // ""')
    ACCEPT=$(printf '%s' "$BEAD" | jq -r '(if type == "array" then .[0] else . end) | (.acceptance_criteria // "") | if type == "array" then map(if type == "string" then . else tostring end) | join("\n") else . end')

    STAMP=$(date +%s)
    MFILE="$SPOOL/$STAMP-$ID.md"
    {
        printf '## Goal\n%s\n\n' "$TITLE"
        printf '## Context\nDispatched from Gas City bead %s (label %s). Work fully autonomously.\n\n%s\n\n' "$ID" "$LABEL" "$DESC"
        printf '## Scoping answers\nNo human is available during this run. Prefer the smallest faithful interpretation; if materially ambiguous, block rather than guess. Validators stay enabled.\n\n'
        printf '## Acceptance hints\n%s\n' "${ACCEPT:-The goal above is demonstrably met.}"
    } > "$MFILE"
    {
        printf 'ID=%s\nCITY=%s\nRIG_DIR=%s\nMAX_CYCLES=%s\n' "$ID" "$CITY" "$RIG_DIR" "$MAX_CYCLES"
    } > "$SPOOL/$STAMP-$ID.env"

    echo "kranz-dispatch: bead $ID spooled for $RIG_DIR"
done
