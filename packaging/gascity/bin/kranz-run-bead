#!/bin/sh
# kranz-run-bead — detached per-bead mission runner (spike).
#
# Invoked by kranz-dispatch with nohup: runs ONE bead's mission to a terminal
# state and translates the exit code back into City state. Detached because
# gc order exec enforces a context deadline — orders dispatch, they must not
# host multi-minute missions (learned live; see docs/gascity.md).
#
# Usage: kranz-run-bead <city-dir> <bead-id> <mission.md> <rig-dir> <max-cycles>
#
# Bidirectional bead status <-> kranz-side state map (all four bead
# statuses, both directions):
#   open         <-> Queued           (ready for dispatch / re-readied)
#   in_progress  <-> Running          (set by kranz-dispatch's atomic claim, before the brief is spooled)
#   blocked      <-> Blocked-report   (exit 2 below; escalated to a human)
#   closed       <-> Done             (exit 0 below; mission complete)
#
# Claim posture / liveness-first heartbeat (ms-3-fix-1-6): dispatch takes an
# atomic, first-wins claim (`bd update --claim`, docs/scoping/beads-bridge-
# dialect.md §3) before spooling the brief this script runs. bd 1.0.5 has no
# TTL/heartbeat field, so this script proves liveness the same way
# kranz-dispatch's dead-claim recovery checks for it: by keeping the claim's
# `updated_at` fresh. While `kranz exec` runs, a background loop re-issues
# the (idempotent, same-actor) `bd update --claim` every
# KRANZ_HEARTBEAT_SECONDS, well inside kranz-dispatch's
# KRANZ_CLAIM_STALE_SECONDS threshold, so a liveness-first dispatcher never
# mistakes a live run for a dead one and never steals it. If this process
# dies, the heartbeat stops, updated_at goes stale, and kranz-dispatch's
# recovery pass reaps the claim on a later cycle.
# Residual exposure: a bead claimed and spooled but not yet picked up by this
# script (i.e. before the heartbeat loop starts) has no heartbeat yet; only
# kranz-dispatch's staleness backstop covers that window.
#
# Exit-code contract (kranz-run-bead owns this translation):
#   0            -> closed  (mission COMPLETE)
#   2            -> blocked (mission BLOCKED, escalate to a human)
#   exit 3       -> open    (refused as UNDERSPECIFIED; refine and re-ready)
#   exit 1/other -> open    (mission FAILED; reopen for re-readying)
#
# open is many-to-one on the kranz side: both exit 3 (refused,
# underspecified brief) and exit 1/other (mission failed outright) return
# the bead to open, because in both cases there is no partial progress
# worth preserving as "blocked" — the bead just needs to be re-readied,
# either after a human refines it (exit 3) or as-is for a retry (exit
# 1/other). Only exit 2 (blocked) preserves an in-flight state for
# escalation; every other non-success outcome collapses to open.
set -u
CITY=$1; ID=$2; MFILE=$3; RIG_DIR=$4; MAX_CYCLES=$5

bd() { gc --city "$CITY" bd "$@"; }

HEARTBEAT_SECONDS=${KRANZ_HEARTBEAT_SECONDS:-300}
heartbeat_loop() {
    while :; do
        sleep "$HEARTBEAT_SECONDS"
        bd update "$ID" --claim >/dev/null 2>&1
    done
}
heartbeat_loop &
HEARTBEAT_PID=$!

LINE=$( cd "$RIG_DIR" && kranz exec -f "$MFILE" --max-cycles "$MAX_CYCLES" 2>>"${MFILE%.md}.events.log" )
CODE=$?

kill "$HEARTBEAT_PID" >/dev/null 2>&1
wait "$HEARTBEAT_PID" 2>/dev/null

# bd flag shapes (learned live): close takes --reason, comment takes the
# text positionally; -m belongs to neither.
case $CODE in
    0)
        bd close "$ID" --reason "kranz mission COMPLETE — $LINE" >/dev/null
        ;;
    2)
        bd update "$ID" --status blocked >/dev/null 2>&1
        bd comment "$ID" "kranz mission BLOCKED — $LINE (event log in the rig's .kranz/missions dir)" >/dev/null
        gc --city "$CITY" mail send human -s "ESCALATION: bead $ID blocked in kranz" \
            -m "kranz mission for bead $ID blocked awaiting guidance. $LINE. Steer via kranz (web/Slack/CLI) or refine the bead and re-ready it." \
            --notify >/dev/null 2>&1 || true
        ;;
    3)
        bd update "$ID" --status open >/dev/null 2>&1
        bd comment "$ID" "kranz refused headless run: UNDERSPECIFIED — refine title/description/acceptance so the brief is self-sufficient, then re-ready. $LINE" >/dev/null
        ;;
    *)
        bd update "$ID" --status open >/dev/null 2>&1
        bd comment "$ID" "kranz mission FAILED (exit $CODE) — $LINE (inspect the rig's .kranz/missions dir)" >/dev/null
        ;;
esac
