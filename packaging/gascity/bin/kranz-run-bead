#!/bin/sh
# kranz-run-bead — per-bead mission runner and City return translator.
#
# Invoked by the supervised kranz-city-worker. Legacy mode runs one spooled
# brief through `kranz exec`; native queued mode drains one exact mission;
# native return-only mode retries a failed City mutation without replaying
# terminal work. Gas City orders never host multi-minute feature execution
# (learned live; see docs/gascity.md).
#
# Usage:
#   kranz-run-bead <city-dir> <bead-id> <mission.md> <rig-dir> <max-cycles>
#   kranz-run-bead --queued <city-dir> <bead-id> <rig-dir> <mission-id>
#   kranz-run-bead --return-only <city-dir> <bead-id> <rig-dir> <mission-id>
#
# Bidirectional bead status <-> kranz-side state map (all four bead
# statuses, both directions):
#   open         <-> Queued           (ready for dispatch / re-readied)
#   in_progress  <-> Running          (set by kranz-dispatch's atomic claim, before enqueue/spool)
#   blocked      <-> Blocked-report   (exit 2 below; escalated to a human)
#   closed       <-> Done             (exit 0 below; mission complete)
#
# Claim posture (shipped in kranz-dispatch, not here): dispatch takes an
# atomic, first-wins claim (`bd update --claim`, docs/scoping/beads-bridge-
# dialect.md §3) before enqueueing or spooling the brief. bd 1.0.5
# itself has NO lease/TTL/heartbeat field — a server-side lease mechanism
# is NOT YET IMPLEMENTED upstream (§3; 1.1.0+ is the tracked path) — so
# the bridge ships its own client-side lease (f-3-1): a heartbeat file
# under ${KRANZ_LEASE_DIR:-$CITY/.gc/kranz-leases}/ renewed while this mission
# runs and removed on any terminal exit ($CITY here is the city directory
# passed by kranz-city-worker, which kranz-dispatch resolved from $GC_CITY
# (and, on the rollback path, wrote into the spool .json). The lease line is
# `<pid> <unix-ts> <start-token>`, the token being this process's start
# time (`ps -o lstart=`, normalized for plain string equality) — the
# sweep's way to tell "pid alive and provably this claimant" from a
# recycled pid wearing the same number (the kranz queue's identity-token
# idiom). Recovery (kranz-dispatch --reclaim) is liveness-first: a claim
# held by a verifiably live pid is never stolen; a provably dead pid
# releases claim, lease, and stale spool pair together; a probe that
# cannot settle it (another uid's process, a recycled token) and a
# missing lease fall to the KRANZ_CLAIM_TTL backstop, which also removes
# the spool pair when it releases so a re-dispatch spools exactly once.
# Native queue work uses a stronger ownership record: enqueue-source.json is
# written before the queue entry and remains active until the City mutation
# is confirmed. A queued, claimed, running, or terminal mission therefore
# stands at any age; a fresh approved source with no queue file protects the
# source-before-queue interval until the receipt's own TTL, after which it is
# the interrupted pre-queue crash shape and becomes recoverable. Residual
# exposure on the legacy spool path: the pre-heartbeat interval still costs at
# most one reclaim cycle's delay, not a duplicate mission.
#
# Claim release on reopen (shipped here): exit 3 and exit 1/other both clear
# the assignee (`bd update --assignee ""`) alongside the status reset to
# open, per docs/scoping/beads-bridge-dialect.md §2 (`bd update`'s verified
# `-a/--assignee` flag; an empty string clears it, confirmed by an executed
# probe against upstream `bd` directly — the `gc bd` pass-through used here
# (via this script's own `bd()` wrapper) is unverified, per dialect doc §2):
# claim, clear via the combined `--status open --assignee ""` call this
# script issues, then a different actor claims the same bead
# successfully — a bare `--assignee ""` without `--status open` was also
# probed and leaves the issue in_progress, still blocking reclaim). A bead
# reopened this way is therefore claimable
# by ANY actor afterward, not stuck assigned to whichever actor ran this
# mission. Exit 2 (blocked) deliberately does NOT clear the assignee: a
# blocked bead is escalated to a human via mail and is never re-offered by
# `bd ready` regardless of assignee (blocked is excluded from ready work), so
# releasing the claim there would not change dispatch behaviour but would
# discard the record of who last worked the bead before a human intervenes.
#
# Exit-code contract (kranz-run-bead owns this translation):
#   0            -> closed  (mission COMPLETE)
#   2            -> blocked (mission BLOCKED, escalate to a human)
#   exit 3       -> open    (refused as UNDERSPECIFIED; refine and re-ready)
#   exit 1/other -> open    (mission FAILED; reopen for re-readying)
#
# open is many-to-one on the kranz side: both exit 3 (refused,
# underspecified brief) and exit 1/other (mission failed outright) return
# the bead to open, because in both cases there is no partial progress
# worth preserving as "blocked" — the bead just needs to be re-readied,
# either after a human refines it (exit 3) or as-is for a retry (exit
# 1/other). Only exit 2 (blocked) preserves an in-flight state for
# escalation; every other non-success outcome collapses to open and releases
# the assignee so a different actor may re-claim it.
#
# Return path (shipped, D-BW-2 brief 2): after the status translation
# below, the bead gets ONE `bd comment` naming the kranz mission id and
# the terminal outcome (COMPLETED/BLOCKED/REFUSED/FAILED), so a bead
# reader sees how the kranz side ended without opening kranz — the
# complement to dispatch's external_ref (the bead becomes navigable to
# kranz's mission record and vice versa). The write is deduped on the
# mission-id string (a re-run of this script for an already-commented
# mission posts nothing) and best-effort (a failed comment never changes
# the exit-code contract). The refuse path's own reason comment (exit 3
# below) is preserved as-is alongside it.
set -u
MODE=exec
case ${1:-} in
    --queued | --return-only)
        MODE=${1#--}
        CITY=$2
        ID=$3
        RIG_DIR=$4
        MISSION_ID=$5
        MFILE="$RIG_DIR/.kranz/missions/$MISSION_ID/gascity-native"
        MAX_CYCLES=""
        ;;
    *)
        CITY=$1
        ID=$2
        MFILE=$3
        RIG_DIR=$4
        MAX_CYCLES=$5
        MISSION_ID=""
        ;;
esac

bd() { gc --city "$CITY" bd "$@"; }

valid_mission_id() {
    printf '%s\n' "$1" | grep -qE '^m-[0-9a-f]{6}$'
}

if [ "$MODE" != "exec" ] && ! valid_mission_id "$MISSION_ID"; then
    echo "kranz-run-bead: refusing unsafe mission id '$MISSION_ID'" >&2
    exit 75
fi

# Best-effort City event emission (Stage 3): surfaces kranz mission progress
# in the city's event stream. `gc event emit` always exits 0, so a failed
# event write never changes the exit-code contract below.
event_emit() {
    TYPE=$1; MSG=$2
    gc --city "$CITY" event emit "$TYPE" --subject "$ID" --message "$MSG" >/dev/null 2>&1 || true
}

# Client-side lease heartbeat (f-3-1): bd 1.0.5 has no lease/TTL/heartbeat
# field, so the bridge keeps its own. While the mission runs, a background
# loop renews $LEASE_FILE with `<pid> <unix-ts> <start-token>`; on ANY
# terminal exit (success, failure, INT, TERM) the loop is killed and the
# file removed — a completed mission never leaves a dangling lease. The
# start-token is this process's `ps -o lstart=` (normalized), so the sweep
# can prove the recorded pid is still THIS claimant rather than a recycled
# pid. Recovery is liveness-first (kranz-dispatch --reclaim): a claim
# whose recorded pid is ALIVE (and token-verified) is never stolen,
# however old; a provably dead pid releases the claim, and anything the
# probe cannot settle (or a missing lease) falls to the TTL backstop —
# every release drops the stale spool pair with it.
LEASE_DIR=${KRANZ_LEASE_DIR:-$CITY/.gc/kranz-leases}
mkdir -p "$LEASE_DIR"
LEASE_FILE="$LEASE_DIR/$ID.lease"
# Normalized for plain string equality with the sweep's own probe of the
# same pid (tr collapses ps's field padding, the seds drop leading and
# trailing whitespace — `read` trims both when the sweep parses the lease).
START_TOKEN=$(ps -o lstart= -p $$ 2>/dev/null | tr -s ' ' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
heartbeat() {
    while :; do
        printf '%s %s %s\n' "$$" "$(date +%s)" "$START_TOKEN" > "$LEASE_FILE.hb.$$.tmp" 2>/dev/null &&
            mv -f "$LEASE_FILE.hb.$$.tmp" "$LEASE_FILE" 2>/dev/null || exit 0
        sleep 15
    done
}
heartbeat &
HEARTBEAT_PID=$!
cleanup_lease() {
    kill "$HEARTBEAT_PID" 2>/dev/null || true
    rm -f "$LEASE_FILE" "$LEASE_FILE.hb.$$.tmp" "$LEASE_FILE.init.$$.tmp"
}
trap 'cleanup_lease' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
printf '%s %s %s\n' "$$" "$(date +%s)" "$START_TOKEN" > "$LEASE_FILE.init.$$.tmp" 2>/dev/null &&
    mv -f "$LEASE_FILE.init.$$.tmp" "$LEASE_FILE" 2>/dev/null || true

if [ "$MODE" != "return-only" ]; then
    event_emit "kranz.mission.started" "kranz mission started for bead $ID"
fi

case $MODE in
    exec)
        LINE=$( cd "$RIG_DIR" && kranz exec -f "$MFILE" --max-cycles "$MAX_CYCLES" 2>>"${MFILE%.md}.events.log" )
        CODE=$?
        ;;
    queued)
        WORK_OUT=$( cd "$RIG_DIR" && kranz work --once --expect "$MISSION_ID" 2>>"$RIG_DIR/.kranz/missions/$MISSION_ID/gascity.events.log" )
        WORK_CODE=$?
        STATUS=$(jq -r '.mission.status // empty' < "$RIG_DIR/.kranz/missions/$MISSION_ID/state.json" 2>/dev/null) || STATUS=""
        LINE="kranz work mission $MISSION_ID status ${STATUS:-unknown} — $(printf '%s' "$WORK_OUT" | tail -1)"
        case $STATUS in
            complete) CODE=0 ;;
            blocked) CODE=2 ;;
            failed | abandoned) CODE=1 ;;
            *)
                echo "kranz-run-bead: mission $MISSION_ID did not reach a terminal state (work exit $WORK_CODE, status ${STATUS:-unknown}); City state left in_progress" >&2
                exit 75
                ;;
        esac
        ;;
    return-only)
        STATUS=$(jq -r '.mission.status // empty' < "$RIG_DIR/.kranz/missions/$MISSION_ID/state.json" 2>/dev/null) || STATUS=""
        LINE="kranz mission $MISSION_ID terminal return retry ($STATUS)"
        case $STATUS in
            complete) CODE=0 ;;
            blocked) CODE=2 ;;
            failed | abandoned) CODE=1 ;;
            *)
                echo "kranz-run-bead: pending return for $MISSION_ID has non-terminal status ${STATUS:-unknown}" >&2
                exit 75
                ;;
        esac
        ;;
esac

# bd flag shapes (learned live): close takes --reason, comment takes the
# text positionally; -m belongs to neither.
case $CODE in
    0)
        bd close "$ID" --reason "kranz mission COMPLETE — $LINE" >/dev/null
        if [ "$MODE" != "return-only" ]; then
            event_emit "kranz.mission.complete" "kranz mission COMPLETE for bead $ID — $LINE"
        fi
        ;;
    2)
        bd update "$ID" --status blocked >/dev/null 2>&1
        if [ "$MODE" != "return-only" ]; then
            bd comment "$ID" "kranz mission BLOCKED — $LINE (event log in the rig's .kranz/missions dir)" >/dev/null
            event_emit "kranz.mission.blocked" "kranz mission BLOCKED for bead $ID — $LINE"
            gc --city "$CITY" mail send human -s "ESCALATION: bead $ID blocked in kranz" \
                -m "kranz mission for bead $ID blocked awaiting guidance. $LINE. Steer via kranz (web/Slack/CLI) or refine the bead and re-ready it." \
                --notify >/dev/null 2>&1 || true
        fi
        ;;
    3)
        bd update "$ID" --status open --assignee "" >/dev/null 2>&1
        if [ "$MODE" != "return-only" ]; then
            bd comment "$ID" "kranz refused headless run: UNDERSPECIFIED — refine title/description/acceptance so the brief is self-sufficient, then re-ready. $LINE" >/dev/null
        fi
        ;;
    *)
        bd update "$ID" --status open --assignee "" >/dev/null 2>&1
        if [ "$MODE" != "return-only" ]; then
            bd comment "$ID" "kranz mission FAILED (exit $CODE) — $LINE (inspect the rig's .kranz/missions dir)" >/dev/null
        fi
        ;;
esac

# Native-queue execution retires the queue claim before the City write above.
# If that write is not yet observable, persist a return-only receipt beside
# the mission (not a runnable waiting room) so the supervised worker retries
# translation without ever re-running the mission.
if [ "$MODE" != "exec" ]; then
    case $CODE in
        0) EXPECTED_STATUS=closed ;;
        2) EXPECTED_STATUS=blocked ;;
        *) EXPECTED_STATUS=open ;;
    esac
    OBSERVED_STATUS=$(bd show "$ID" --json 2>/dev/null |
        jq -r '(if type == "array" then .[0] else . end) | .status // empty' 2>/dev/null | head -1)
    PENDING="$RIG_DIR/.kranz/missions/$MISSION_ID/gascity-return-pending.json"
    if [ "$OBSERVED_STATUS" = "$EXPECTED_STATUS" ]; then
        # Retire the active producer binding only after the City transition is
        # observable. The archived receipt remains auditable but no longer
        # participates in worker scans. This is what lets a sibling generic
        # `kranz work` drain complete the mission without losing its return.
        SOURCE="$RIG_DIR/.kranz/missions/$MISSION_ID/enqueue-source.json"
        RETURNED="$RIG_DIR/.kranz/missions/$MISSION_ID/enqueue-source.returned.json"
        if [ -e "$SOURCE" ] && ! mv -f "$SOURCE" "$RETURNED"; then
            echo "kranz-run-bead: City return confirmed but source receipt could not be retired for $MISSION_ID" >&2
            exit 75
        fi
        rm -f "$PENDING" "$PENDING.tmp.$$"
    else
        PENDING_TMP=$(mktemp "$PENDING.tmp.XXXXXX") || {
            echo "kranz-run-bead: could not create a safe City return receipt for $MISSION_ID" >&2
            exit 75
        }
        if jq -n --arg id "$ID" --arg missionId "$MISSION_ID" --arg expected "$EXPECTED_STATUS" \
            '{beadId:$id, missionId:$missionId, expectedStatus:$expected}' > "$PENDING_TMP"; then
            mv -f "$PENDING_TMP" "$PENDING" || { rm -f "$PENDING_TMP"; exit 75; }
        else
            rm -f "$PENDING_TMP"
            exit 75
        fi
        echo "kranz-run-bead: City return for $MISSION_ID is unconfirmed (expected $EXPECTED_STATUS, observed ${OBSERVED_STATUS:-unknown}); retry receipt kept" >&2
        exit 75
    fi
fi

# Return path (D-BW-2 brief 2): one comment naming the kranz mission id
# and the terminal outcome, deduped on the mission-id string so a re-run
# never double-posts. The mission id is the first m-xxxxxx token in the
# mission's summary output; absent one (a kranz too old to print it), the
# comment is skipped rather than posted contentless. Best-effort: a failed
# write changes nothing about the status translation above.
if [ -z "$MISSION_ID" ]; then
    MISSION_ID=$(printf '%s' "$LINE" | grep -oE 'm-[0-9a-f]{6}' | head -1 || true)
fi
if [ -n "$MISSION_ID" ]; then
    case $CODE in
        0) OUTCOME="COMPLETED" ;;
        2) OUTCOME="BLOCKED (escalated)" ;;
        3) OUTCOME="REFUSED (underspecified brief)" ;;
        *) OUTCOME="FAILED (exit $CODE)" ;;
    esac
    ALREADY=$(bd show "$ID" --json --include-comments 2>/dev/null |
        jq -r '(if type == "array" then .[0] else . end) | [.comments // [] | .[] | .text | select(contains("'"$MISSION_ID"'"))] | length' 2>/dev/null || echo 0)
    if [ "${ALREADY:-0}" -eq 0 ]; then
        bd comment "$ID" "kranz mission $MISSION_ID terminal outcome: $OUTCOME — event log in the rig's .kranz/missions/$MISSION_ID/" >/dev/null 2>&1 || true
    fi
fi
