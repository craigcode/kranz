#!/bin/sh
# kranz-city-worker — Gas City → kranz bridge, execution side.
#
# Long-lived, SUPERVISED drain loop (replaces the spike's unsupervised nohup):
# picks the oldest spooled brief, runs it through kranz-run-bead (which owns
# the exit-code → City-state mapping), removes the spool entry, repeats.
# Strictly serial — kranz missions serialize per repo anyway, and one worker
# per city keeps the spend faucet single-valved.
#
# Intended to run under the City supervisor as a named non-LLM session (see
# packaging/gascity/agents/kranz-worker/) or any process manager. --once
# drains at most one entry and exits (tests, cron).
#
# Spool records are DATA, not shell (12th-pass review): kranz-dispatch writes
# each record as jq-escaped JSON and this worker parses it with jq — the
# spike-era `. "$ENV_FILE"` sourcing made a metacharacter-bearing rig path
# arbitrary code execution in this unsanitized process.
#
# Idempotency (12th-pass review): an .inflight marker is written BEFORE the
# mission starts, and the startup sweep below reconciles any marker left by
# a crash — a worker that dies after kranz-run-bead closed/blocked the bead
# but before the entry sweep must not replay the whole mission on restart.
# drain_one additionally verifies the bead is still in_progress immediately
# before executing: a released (reclaimed) or already-driven bead is not
# ours to run, and its stale entry is dropped instead.
#
# Env: KRANZ_SPOOL (default $GC_CITY/.gc/kranz-spool)
set -u

CITY=${GC_CITY:?GC_CITY is required}
SPOOL=${KRANZ_SPOOL:-$CITY/.gc/kranz-spool}
BIN_DIR=$(dirname "$0")
ONCE=${1:-}
mkdir -p "$SPOOL"

bd() { gc --city "$CITY" bd "$@"; }

bead_status() {
    # $1 = bead id; echoes its status (empty on any bd/jq failure — callers
    # treat empty as UNKNOWN, never as a concrete state).
    bd show "$1" --json 2>/dev/null |
        jq -r '(if type == "array" then .[0] else . end) | .status // empty' 2>/dev/null | head -1
}

# Single-instance guard: a second worker exits quietly rather than racing.
LOCK="$SPOOL/.worker-lock"
if ! mkdir "$LOCK" 2>/dev/null; then
    echo "kranz-city-worker: another worker holds $LOCK; exiting"
    exit 0
fi
trap 'rmdir "$LOCK" 2>/dev/null' EXIT INT TERM

# Crash recovery: reconcile any .inflight marker left by a previous worker.
# Terminal bead (closed/blocked) => the mission completed before the crash —
# sweep the entry only. Still in_progress => the mission died too — drop the
# stale entry and let the reclaim sweep recover the claim (it re-dispatches
# a FRESH brief; the spool-atomic release prevents a duplicate). Unknown =>
# leave everything (the conservative posture, matching the sweep's).
for MARKER in "$SPOOL"/*.inflight; do
    [ -e "$MARKER" ] || continue
    BASE="${MARKER%.inflight}"
    ID=$(jq -r '.id // empty' < "$BASE.json" 2>/dev/null) || ID=""
    if [ -z "$ID" ]; then
        echo "kranz-city-worker: inflight entry $BASE is unreadable; left in place" >&2
        continue
    fi
    STATUS=$(bead_status "$ID")
    case $STATUS in
        closed | blocked)
            echo "kranz-city-worker: bead $ID reached '$STATUS' before the crash; sweeping $BASE"
            rm -f "$BASE".*
            ;;
        in_progress)
            echo "kranz-city-worker: bead $ID died mid-mission; dropping stale entry (the reclaim sweep re-dispatches fresh)"
            rm -f "$BASE".*
            ;;
        *)
            echo "kranz-city-worker: bead $ID state unknown; inflight entry $BASE left in place" >&2
            ;;
    esac
done

drain_one() {
    ENV_FILE=$(ls "$SPOOL"/*.json 2>/dev/null | sort | head -1)
    [ -n "$ENV_FILE" ] || return 1
    MFILE="${ENV_FILE%.json}.md"
    # Parse the record as DATA (see the header): jq, never source.
    ID=$(jq -r '.id // empty' < "$ENV_FILE") || ID=""
    RIG_DIR=$(jq -r '.rigDir // empty' < "$ENV_FILE") || RIG_DIR=""
    MAX_CYCLES=$(jq -r '.maxCycles // "1"' < "$ENV_FILE") || MAX_CYCLES="1"
    if [ -z "$ID" ] || [ -z "$RIG_DIR" ]; then
        # An unreadable record is an operator problem, not a reason to
        # destroy a brief: log, skip past it this pass, leave it in place.
        echo "kranz-city-worker: $ENV_FILE is not a parseable spool record; left in place" >&2
        sleep 15
        return 0
    fi
    # Ownership guard: only an in_progress bead is ours to run. A CONCRETE
    # other state (released and reclaimed elsewhere, or driven terminal)
    # makes the entry stale — drop it. An UNREADABLE state is unknown —
    # leave the entry for a later pass (a transient City failure must not
    # destroy queued work, the same rule the sweep's release path keeps).
    STATUS=$(bead_status "$ID")
    case $STATUS in
        in_progress) : ;;
        "")
            echo "kranz-city-worker: bead $ID state unreadable; entry left for a later pass" >&2
            sleep 15
            return 0
            ;;
        *)
            echo "kranz-city-worker: bead $ID is '$STATUS' (not in_progress); dropping stale spool entry"
            rm -f "${ENV_FILE%.json}".*
            return 0
            ;;
    esac
    # Mark in-flight BEFORE the mission starts (see the header).
    : > "${ENV_FILE%.json}.inflight"
    echo "kranz-city-worker: bead $ID -> kranz exec (rig $RIG_DIR)"
    "$BIN_DIR/kranz-run-bead" "$CITY" "$ID" "$MFILE" "$RIG_DIR" "$MAX_CYCLES"
    # Sweep the whole entry (brief, record, marker, the runner's events.log).
    rm -f "${ENV_FILE%.json}".*
    return 0
}

if [ "$ONCE" = "--once" ]; then
    drain_one || echo "kranz-city-worker: spool empty"
    exit 0
fi

echo "kranz-city-worker: watching $SPOOL"
while :; do
    drain_one || sleep 15
done
