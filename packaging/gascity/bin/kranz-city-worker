#!/bin/sh
# kranz-city-worker — Gas City → kranz bridge, execution side.
#
# Long-lived, SUPERVISED drain loop (replaces the spike's unsupervised nohup):
# picks the oldest spooled brief, runs it through kranz-run-bead (which owns
# the exit-code → City-state mapping), removes the spool entry, repeats.
# Strictly serial — kranz missions serialize per repo anyway, and one worker
# per city keeps the spend faucet single-valved.
#
# Intended to run under the City supervisor as a named non-LLM session (see
# packaging/gascity/agents/kranz-worker/) or any process manager. --once
# drains at most one entry and exits (tests, cron).
#
# Spool records are DATA, not shell (12th-pass review): kranz-dispatch writes
# each record as jq-escaped JSON and this worker parses it with jq — the
# spike-era `. "$ENV_FILE"` sourcing made a metacharacter-bearing rig path
# arbitrary code execution in this unsanitized process.
#
# Idempotency (12th-pass review): an .inflight marker is written BEFORE the
# mission starts, and the startup sweep below reconciles any marker left by
# a crash — a worker that dies after kranz-run-bead closed/blocked the bead
# but before the entry sweep must not replay the whole mission on restart.
# drain_one additionally verifies the bead is still in_progress immediately
# before executing: a released (reclaimed) or already-driven bead is not
# ours to run, and its stale entry is dropped instead.
#
# Terminal confirmation (13th-pass review): the mission record is deleted
# ONLY after the bead's terminal state is confirmed live. run-bead's own bd
# writes are best-effort (`>/dev/null`), so a transient City failure can
# leave the bead in_progress after a completed mission. Deleting the entry
# there destroys the recovery trail; re-draining it replays the mission.
# An unconfirmed entry is therefore DEFERRED aside (out of the drain glob)
# for the startup sweep and the operator — never re-run, never silently
# dropped.
#
# Worker lock (13th-pass review): the single-instance lock is a directory
# holding `<pid> <start-token>` (the lease idiom, kranz-dispatch's
# lease_pid_token). A plain mkdir survives SIGKILL/host crash and would
# disable dispatch forever; a contended lock is reclaimed only when the
# recorded process is provably gone (dead pid, or a recycled one) — an
# alive-by-token holder is never stolen from, and an unverifiable one is
# left alone (a false stand delays work; a false steal double-runs it).
#
# Env: KRANZ_SPOOL (default $GC_CITY/.gc/kranz-spool)
set -u

CITY=${GC_CITY:?GC_CITY is required}
SPOOL=${KRANZ_SPOOL:-$CITY/.gc/kranz-spool}
BIN_DIR=$(dirname "$0")
ONCE=${1:-}
mkdir -p "$SPOOL"

bd() { gc --city "$CITY" bd "$@"; }

bead_status() {
    # $1 = bead id; echoes its status (empty on any bd/jq failure — callers
    # treat empty as UNKNOWN, never as a concrete state).
    bd show "$1" --json 2>/dev/null |
        jq -r '(if type == "array" then .[0] else . end) | .status // empty' 2>/dev/null | head -1
}

# The process start-time token for a live pid, normalized for plain string
# equality (duplicated from kranz-dispatch's lease_pid_token — these
# scripts share no library by design).
pid_start_token() {
    ps -o lstart= -p "$1" 2>/dev/null | tr -s ' ' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//'
}

# Single-instance guard with crash-safe reclaim: the lock dir carries the
# holder's pid + start token. On contention, a provably-dead holder
# (kill -0 fails AND ps shows no such pid) or a provably-recycled one
# (token mismatch) loses the lock; anything uncertain (unreadable,
# unverifiable) stands the holder and we exit quietly.
LOCK="$SPOOL/.worker-lock"
if ! mkdir "$LOCK" 2>/dev/null; then
    read -r LOCK_PID LOCK_TOKEN < "$LOCK/holder" 2>/dev/null || LOCK_PID=""
    if [ -z "$LOCK_PID" ]; then
        # Fresh mkdir whose holder file is not yet written: bounded retry
        # (sub-millisecond window), then treat as an abandoned shell.
        ATTEMPT=0
        while [ -z "$LOCK_PID" ] && [ "$ATTEMPT" -lt 2 ]; do
            sleep 1
            read -r LOCK_PID LOCK_TOKEN < "$LOCK/holder" 2>/dev/null || LOCK_PID=""
            ATTEMPT=$((ATTEMPT + 1))
        done
    fi
    RECLAIM=0
    if [ -n "$LOCK_PID" ]; then
        if ! kill -0 "$LOCK_PID" 2>/dev/null; then
            # kill -0 failed: ESRCH (truly gone) vs EPERM (another uid).
            if [ -z "$(ps -o pid= -p "$LOCK_PID" 2>/dev/null)" ]; then
                RECLAIM=1 # provably dead
            fi
        elif [ -n "$LOCK_TOKEN" ]; then
            CURRENT=$(pid_start_token "$LOCK_PID")
            if [ -n "$CURRENT" ] && [ "$CURRENT" != "$LOCK_TOKEN" ]; then
                RECLAIM=1 # alive but a recycled pid wearing the holder's number
            fi
        fi
    else
        RECLAIM=1 # no holder file after retries: an abandoned lock shell
    fi
    # Re-acquire only after contention: either the reclaim cleared a stale
    # lock, or the holder stands (a live-by-token holder is never stolen).
    if [ "$RECLAIM" -eq 1 ]; then
        echo "kranz-city-worker: reclaiming a stale worker lock (holder ${LOCK_PID:-unknown} is gone)"
        rm -f "$LOCK/holder" 2>/dev/null
        rmdir "$LOCK" 2>/dev/null
    fi
    if ! mkdir "$LOCK" 2>/dev/null; then
        echo "kranz-city-worker: another worker holds $LOCK; exiting"
        exit 0
    fi
fi
printf '%s %s\n' "$$" "$(pid_start_token "$$")" > "$LOCK/holder.tmp.$$" 2>/dev/null &&
    mv -f "$LOCK/holder.tmp.$$" "$LOCK/holder" 2>/dev/null || true
trap 'rm -f "$LOCK/holder" 2>/dev/null; rmdir "$LOCK" 2>/dev/null' EXIT INT TERM

# Crash/deferral recovery: reconcile any .inflight or .deferred entry left
# by a previous worker. Terminal bead (closed/blocked) => the mission
# completed — sweep the entry only. Still in_progress => the mission died
# too — drop the stale entry and let the reclaim sweep recover the claim
# (it re-dispatches a FRESH brief; the spool-atomic release prevents a
# duplicate). Unknown => leave everything (the conservative posture).
# A .deferred entry (terminal-unconfirmed at run end, 13th-pass) is swept
# only when the bead is NOW confirmed terminal; otherwise it stays for the
# operator — deferred entries are never re-run.
for MARKER in "$SPOOL"/*.inflight "$SPOOL"/*.deferred; do
    [ -e "$MARKER" ] || continue
    # The per-file renames (x.json.deferred etc.) also end in .deferred;
    # only the bare BASE.deferred marker is a recovery record.
    case $MARKER in
        *.json.deferred | *.md.deferred | *.inflight.deferred | *.events.log.deferred)
            continue
            ;;
    esac
    BASE="${MARKER%.inflight}"
    BASE="${BASE%.deferred}"
    ID=$(jq -r '.id // empty' < "$BASE.json" 2>/dev/null) || ID=""
    if [ -z "$ID" ]; then
        echo "kranz-city-worker: recovery entry $BASE is unreadable; left in place" >&2
        continue
    fi
    STATUS=$(bead_status "$ID")
    case $STATUS in
        closed | blocked)
            echo "kranz-city-worker: bead $ID reached '$STATUS'; sweeping $BASE"
            rm -f "$BASE".*
            ;;
        in_progress)
            case $MARKER in
                *.deferred)
                    echo "kranz-city-worker: bead $ID still in_progress; deferred entry $BASE kept for the operator (never re-run)" >&2
                    ;;
                *)
                    echo "kranz-city-worker: bead $ID died mid-mission; dropping stale entry (the reclaim sweep re-dispatches fresh)"
                    rm -f "$BASE".*
                    ;;
            esac
            ;;
        *)
            echo "kranz-city-worker: bead $ID state unknown; recovery entry $BASE left in place" >&2
            ;;
    esac
done

# Move a spool entry aside as .deferred — out of the drain glob, never
# re-run, kept for the startup sweep and the operator. The suffix goes at
# the END (x.json.deferred): a `*.json` glob must never re-pick it.
defer_entry() {
    # $1 = the entry's .json path
    BASE="${1%.json}"
    for EXT in md json inflight events.log; do
        [ -e "$BASE.$EXT" ] && mv "$BASE.$EXT" "$BASE.$EXT.deferred"
    done
    : > "$BASE.deferred"
}

drain_one() {
    ENV_FILE=$(ls "$SPOOL"/*.json 2>/dev/null | sort | head -1)
    [ -n "$ENV_FILE" ] || return 1
    MFILE="${ENV_FILE%.json}.md"
    # Parse the record as DATA (see the header): jq, never source.
    ID=$(jq -r '.id // empty' < "$ENV_FILE") || ID=""
    RIG_DIR=$(jq -r '.rigDir // empty' < "$ENV_FILE") || RIG_DIR=""
    MAX_CYCLES=$(jq -r '.maxCycles // "1"' < "$ENV_FILE") || MAX_CYCLES="1"
    if [ -z "$ID" ] || [ -z "$RIG_DIR" ]; then
        # An unreadable record is an operator problem, not a reason to
        # destroy a brief: log, skip past it this pass, leave it in place.
        echo "kranz-city-worker: $ENV_FILE is not a parseable spool record; left in place" >&2
        sleep 15
        return 0
    fi
    # Ownership guard: only an in_progress bead is ours to run. A CONCRETE
    # other state (released and reclaimed elsewhere, or driven terminal)
    # makes the entry stale — drop it. An UNREADABLE state is unknown —
    # leave the entry for a later pass (a transient City failure must not
    # destroy queued work, the same rule the sweep's release path keeps).
    STATUS=$(bead_status "$ID")
    case $STATUS in
        in_progress) : ;;
        "")
            echo "kranz-city-worker: bead $ID state unreadable; entry left for a later pass" >&2
            sleep 15
            return 0
            ;;
        *)
            echo "kranz-city-worker: bead $ID is '$STATUS' (not in_progress); dropping stale spool entry"
            rm -f "${ENV_FILE%.json}".*
            return 0
            ;;
    esac
    # Mark in-flight BEFORE the mission starts (see the header).
    : > "${ENV_FILE%.json}.inflight"
    echo "kranz-city-worker: bead $ID -> kranz exec (rig $RIG_DIR)"
    "$BIN_DIR/kranz-run-bead" "$CITY" "$ID" "$MFILE" "$RIG_DIR" "$MAX_CYCLES"
    # Terminal confirmation (13th-pass): sweep ONLY on a confirmed terminal
    # state — closed/blocked (run-bead recorded the outcome) or open (it
    # released the claim for re-readying). Still in_progress means the
    # terminal bd write FAILED transiently: defer the entry aside — never
    # re-run, never silently destroyed. Unreadable is unknown: same.
    STATUS=$(bead_status "$ID")
    case $STATUS in
        closed | blocked | open)
            # Sweep the whole entry (brief, record, marker, events sidecar).
            rm -f "${ENV_FILE%.json}".*
            ;;
        *)
            echo "kranz-city-worker: bead $ID terminal state UNCONFIRMED after the run ('${STATUS:-unknown}') — entry deferred aside, NOT re-run and NOT destroyed" >&2
            defer_entry "$ENV_FILE"
            ;;
    esac
    return 0
}

if [ "$ONCE" = "--once" ]; then
    drain_one || echo "kranz-city-worker: spool empty"
    exit 0
fi

echo "kranz-city-worker: watching $SPOOL"
while :; do
    drain_one || sleep 15
done
