{
  "gates": [
    {
      "command": "cargo fmt --all --check"
    },
    {
      "command": "cargo clippy --workspace --all-targets -- -D warnings"
    },
    {
      "command": "cargo test --workspace"
    },
    {
      "command": "npm ci",
      "cwd": "apps/dashboard",
      "whenPaths": [
        "apps/dashboard"
      ]
    },
    {
      "command": "npx tsc -b",
      "cwd": "apps/dashboard",
      "whenPaths": [
        "apps/dashboard"
      ]
    },
    {
      "command": "npm run build",
      "cwd": "apps/dashboard",
      "whenPaths": [
        "apps/dashboard"
      ]
    },
    {
      "command": "npm run check-embedded",
      "cwd": "apps/dashboard",
      "whenPaths": [
        "apps/dashboard"
      ]
    },
    {
      "command": "npm run test",
      "cwd": "apps/dashboard",
      "whenPaths": [
        "apps/dashboard"
      ]
    },
    {
      "command": "npm run lint",
      "cwd": "apps/dashboard",
      "whenPaths": [
        "apps/dashboard"
      ]
    },
    {
      "command": "bash packaging/gascity/test/check-dialect-doc.sh",
      "whenPaths": [
        "docs/scoping/beads-bridge-dialect.md",
        "packaging/gascity/bin/kranz-run-bead"
      ]
    },
    {
      "command": "bash packaging/gascity/test/check-bridge-hygiene.sh",
      "whenPaths": [
        "packaging/gascity"
      ]
    },
    {
      "command": "bash packaging/gascity/test/check-bridge-hygiene.sh --status-map",
      "whenPaths": [
        "packaging/gascity"
      ]
    },
    {
      "command": "bash packaging/gascity/test/kranz-dispatch-roundtrip.sh",
      "whenPaths": [
        "packaging/gascity"
      ]
    },
    {
      "command": "bash packaging/gascity/test/check-bridge-hygiene-selftest.sh",
      "whenPaths": [
        "packaging/gascity"
      ]
    },
    {
      "command": "bash packaging/gascity/test/kranz-dispatch-roundtrip-selftest.sh",
      "whenPaths": [
        "packaging/gascity"
      ]
    }
  ]
}
