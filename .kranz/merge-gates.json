{
  "gates": [
    {
      "command": "cargo fmt --all --check"
    },
    {
      "command": "cargo clippy --workspace --all-targets -- -D warnings"
    },
    {
      "command": "cargo test --workspace"
    },
    {
      "command": "npm ci",
      "cwd": "apps/dashboard",
      "whenPaths": [
        "apps/dashboard"
      ]
    },
    {
      "command": "npx tsc -b",
      "cwd": "apps/dashboard",
      "whenPaths": [
        "apps/dashboard"
      ]
    },
    {
      "command": "npm run build",
      "cwd": "apps/dashboard",
      "whenPaths": [
        "apps/dashboard"
      ]
    },
    {
      "command": "npm run check-embedded",
      "cwd": "apps/dashboard",
      "whenPaths": [
        "apps/dashboard"
      ]
    },
    {
      "command": "npm run test",
      "cwd": "apps/dashboard",
      "whenPaths": [
        "apps/dashboard"
      ]
    },
    {
      "command": "npm run lint",
      "cwd": "apps/dashboard",
      "whenPaths": [
        "apps/dashboard"
      ]
    }
  ]
}
