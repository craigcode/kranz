{
  "gates": [
    {
      "command": "cargo fmt --all --check"
    },
    {
      "command": "cargo clippy --workspace --all-targets -- -D warnings"
    },
    {
      "command": "cargo test --workspace"
    },
    {
      "command": "npm ci",
      "cwd": "apps/dashboard",
      "whenPaths": [
        "apps/dashboard"
      ]
    },
    {
      "command": "npx tsc -b",
      "cwd": "apps/dashboard",
      "whenPaths": [
        "apps/dashboard"
      ]
    },
    {
      "command": "npm run build",
      "cwd": "apps/dashboard",
      "whenPaths": [
        "apps/dashboard"
      ]
    },
    {
      "command": "npm run check-embedded",
      "cwd": "apps/dashboard",
      "whenPaths": [
        "apps/dashboard"
      ]
    },
    {
      "command": "npm run test",
      "cwd": "apps/dashboard",
      "whenPaths": [
        "apps/dashboard"
      ]
    },
    {
      "command": "npm run lint",
      "cwd": "apps/dashboard",
      "whenPaths": [
        "apps/dashboard"
      ]
    },
    {
      "command": "bash packaging/gascity/test/check-dialect-doc.sh",
      "whenPaths": [
        "docs/scoping/beads-bridge-dialect.md"
      ]
    },
    {
      "command": "bash packaging/gascity/test/check-rust-toolchain-pinned.sh",
      "whenPaths": [
        "rust-toolchain.toml"
      ]
    },
    {
      "command": "bash packaging/gascity/test/check-clippy-toolchain-resolves.sh",
      "whenPaths": [
        "rust-toolchain.toml"
      ]
    },
    {
      "command": "bash packaging/gascity/test/check-fmt-toolchain-resolves.sh",
      "whenPaths": [
        "rust-toolchain.toml"
      ]
    },
    {
      "command": "bash packaging/gascity/test/check-build-toolchain-resolves.sh",
      "whenPaths": [
        "rust-toolchain.toml"
      ]
    }
  ]
}
