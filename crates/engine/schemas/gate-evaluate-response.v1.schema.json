{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kranz:gate:response:1",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "$ref": "urn:kranz:gate:common:1#/$defs/id"
        },
        "result": {
          "type": "object",
          "properties": {
            "schemaVersion": {
              "const": 1
            },
            "evaluationId": {
              "$ref": "urn:kranz:gate:common:1#/$defs/id"
            },
            "attemptId": {
              "$ref": "urn:kranz:gate:common:1#/$defs/id"
            },
            "binding": {
              "$ref": "urn:kranz:gate:common:1#/$defs/binding"
            },
            "evidenceDigest": {
              "$ref": "urn:kranz:gate:common:1#/$defs/digest"
            },
            "status": {
              "enum": [
                "judged",
                "escalate"
              ]
            },
            "verdict": {
              "enum": [
                "pass",
                "fail"
              ]
            },
            "rationale": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            "artifacts": {
              "type": "array",
              "items": {
                "$ref": "urn:kranz:gate:common:1#/$defs/artifactRef"
              },
              "minItems": 0,
              "maxItems": 128
            },
            "findings": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "$ref": "urn:kranz:gate:common:1#/$defs/id"
                  },
                  "severity": {
                    "enum": [
                      "info",
                      "low",
                      "medium",
                      "high",
                      "critical"
                    ]
                  },
                  "summary": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "evidence": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "artifactId": {
                          "$ref": "urn:kranz:gate:common:1#/$defs/id"
                        },
                        "digest": {
                          "$ref": "urn:kranz:gate:common:1#/$defs/digest"
                        },
                        "lineStart": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 9007199254740991
                        },
                        "lineEnd": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 9007199254740991
                        }
                      },
                      "required": [
                        "artifactId",
                        "digest"
                      ],
                      "additionalProperties": false,
                      "dependentRequired": {
                        "lineStart": [
                          "lineEnd"
                        ],
                        "lineEnd": [
                          "lineStart"
                        ]
                      }
                    },
                    "minItems": 1,
                    "maxItems": 32
                  }
                },
                "required": [
                  "id",
                  "severity",
                  "summary",
                  "evidence"
                ],
                "additionalProperties": false
              },
              "minItems": 0,
              "maxItems": 128
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "schemaVersion",
            "evaluationId",
            "attemptId",
            "binding",
            "evidenceDigest",
            "status",
            "rationale",
            "artifacts"
          ],
          "additionalProperties": false,
          "oneOf": [
            {
              "properties": {
                "status": {
                  "const": "judged"
                }
              },
              "required": [
                "verdict"
              ]
            },
            {
              "properties": {
                "status": {
                  "const": "escalate"
                }
              },
              "not": {
                "required": [
                  "verdict"
                ]
              }
            }
          ]
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "result"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "oneOf": [
            {
              "$ref": "urn:kranz:gate:common:1#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "enum": [
                -32700,
                -32600,
                -32601,
                -32602,
                -32603,
                1001,
                1002,
                1003,
                1004
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "data": {
              "type": "object",
              "properties": {
                "evaluationId": {
                  "$ref": "urn:kranz:gate:common:1#/$defs/id"
                },
                "attemptId": {
                  "$ref": "urn:kranz:gate:common:1#/$defs/id"
                }
              },
              "required": [],
              "additionalProperties": false
            }
          },
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "error"
      ],
      "additionalProperties": false,
      "if": {
        "properties": {
          "id": {
            "type": "null"
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "properties": {
              "code": {
                "enum": [
                  -32700,
                  -32600
                ]
              }
            }
          }
        }
      }
    }
  ]
}
