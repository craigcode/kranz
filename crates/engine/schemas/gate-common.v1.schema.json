{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kranz:gate:common:1",
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*(?![\\s\\S])"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]*(/[A-Za-z0-9_-][A-Za-z0-9_.-]*)*(?![\\s\\S])"
    },
    "gitObject": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "algorithm": {
              "const": "sha1"
            },
            "value": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}(?![\\s\\S])"
            }
          },
          "required": [
            "algorithm",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "algorithm": {
              "const": "sha256"
            },
            "value": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
            }
          },
          "required": [
            "algorithm",
            "value"
          ],
          "additionalProperties": false
        }
      ]
    },
    "binding": {
      "type": "object",
      "properties": {
        "subjectDigest": {
          "$ref": "urn:kranz:gate:common:1#/$defs/digest"
        },
        "planDigest": {
          "$ref": "urn:kranz:gate:common:1#/$defs/digest"
        },
        "policyDigest": {
          "$ref": "urn:kranz:gate:common:1#/$defs/digest"
        },
        "registrationDigest": {
          "$ref": "urn:kranz:gate:common:1#/$defs/digest"
        },
        "workspaceId": {
          "$ref": "urn:kranz:gate:common:1#/$defs/id"
        }
      },
      "required": [
        "subjectDigest",
        "planDigest",
        "policyDigest",
        "registrationDigest",
        "workspaceId"
      ],
      "additionalProperties": false
    },
    "artifactRef": {
      "type": "object",
      "properties": {
        "path": {
          "$ref": "urn:kranz:gate:common:1#/$defs/path"
        },
        "digest": {
          "$ref": "urn:kranz:gate:common:1#/$defs/digest"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 67108864
        }
      },
      "required": [
        "path",
        "digest",
        "bytes"
      ],
      "additionalProperties": false
    },
    "inputArtifactRef": {
      "allOf": [
        {
          "$ref": "urn:kranz:gate:common:1#/$defs/artifactRef"
        },
        {
          "properties": {
            "path": {
              "pattern": "^inputs/"
            }
          }
        }
      ]
    },
    "deadline": {
      "type": "string",
      "minLength": 20,
      "maxLength": 20,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z(?![\\s\\S])",
      "format": "date-time"
    }
  }
}
